# Demo using countSimEval built-in dataset
data("origin_sce_293T_jurkat", "ESCO_sce_293T_jurkat", "muscat_sce_293T_jurkat", "scDesign3_sce_293T_jurkat")
SCEList <- list(
origin = origin_sce_293T_jurkat,
