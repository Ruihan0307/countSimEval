n <- nlevels(factor(group))
contrast <- list()
for (i in 1:(n - 1)) {
# 内层循环，遍历从 i+1 到 n 的组
for (j in (i + 1):n) {
# 生成一个长度为 n 的全 0 向量
vec <- rep(0, n)
# 第 i 个位置设为 -1
vec[i] <- -1
# 第 j 个位置设为 1
vec[j] <- 1
# 生成对比名称
contrast_name <- paste0("Gp", i, "vsGp", j)
# 将对比向量添加到列表中
contrast[[contrast_name]] <- vec
}
}
View(contrast)
lt <- glmLRT(fit, contrast=contrast)
contrast <- contrast[[1]]
lt <- glmLRT(fit, contrast=contrast)
View(lt)
lt <- glmQLFTest(fit, contrast=contrast)
fit <- glmQLFit(dgelist, design, robust=T)
